{
  "name": "normie-mode",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "setup": "npm ci --include=dev",
    "serve": "bun server/index.ts",
    "stop": "pkill -f 'bun server/index.ts' || true",
    "check": "astro check",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "import": "tsx scripts/import.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:generate": "tsx scripts/eval-generate.ts",
    "demand": "tsx scripts/demand.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "hyparquet": "^1.31.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
