---
import NormSays from './NormSays.astro';
import { renderSlot } from '../lib/norm';
import { overviewRows } from '../lib/overview';
import { topTwoTied } from '../lib/tasks';
// One metric, one chart (D-021). Horizontal bars so model names stay readable at any width.
// Single series colour; identity comes from the row label. Values sit at the bar tip.
export interface BarDatum {
  id: string;
  label: string;
  maker?: string;
  href?: string;
  value?: number;
  display?: string;
  low?: number;
  high?: number;
  tip?: string;
  muted?: boolean;
}
interface Props {
  title: string;
  sub: string;
  rows: BarDatum[];
  lowerIsBetter?: boolean;
  summary?: string;
  source?: { name: string; url: string; note?: string };
  /** Floor for the axis so small differences near the top remain visible (e.g. index scores). */
  floor?: number;
  id?: string;
  showEmpty?: boolean;
  /** Narrow cards: shorter labels, no maker names. */
  compact?: boolean;
  /** Let Norm point out when the top two are too close to call (from the data, so it's never generic). */
  tieNote?: boolean;
  /** Our own test: show the "Tested by us" tag by the title. */
  ours?: boolean;
}
const { title, sub, rows, lowerIsBetter = false, summary, source, floor = 0, id, showEmpty = true, compact = false, tieNote = true, ours = false } = Astro.props;
const withValue = rows.filter((r) => r.value !== undefined);
const sorted = [...withValue].sort((a, b) => (lowerIsBetter ? a.value! - b.value! : b.value! - a.value!));
const empty = showEmpty ? rows.filter((r) => r.value === undefined) : [];
const max = Math.max(...withValue.map((r) => r.high ?? r.value!), 0);
// The top two's likely ranges overlap: say so, and let price decide between them.
const tied = tieNote && !compact ? topTwoTied(rows, lowerIsBetter) : undefined;
const priceOf = (id: string) => overviewRows().find((r) => r.model.id === id)?.costPer1000;
const tieFacts = (() => {
  if (!tied) return undefined;
  const [first, second] = tied;
  const [p1, p2] = [priceOf(first.id), priceOf(second.id)];
  const priced = p1 !== undefined && p2 !== undefined;
  const [cheap, dear] = priced && p1! <= p2! ? [first, second] : [second, first];
  const ratio = priced ? Math.max(p1!, p2!) / Math.min(p1!, p2!) : 1;
  return { first: first.label, second: second.label, cost_differs: ratio >= 1.5, cheaper: cheap.label, dearer: dear.label, price_ratio: Math.round(ratio) };
})();
const tie = tieFacts ? renderSlot('chart.tie', tieFacts) : undefined;
const pct = (v: number) => `${Math.max(0, ((v - floor) / (max - floor || 1)) * 100)}%`;
---
<section class={`chart-card${compact ? ' is-compact' : ''}`} id={id}>
  <h3 class="chart-title">{title}{ours && <span class="badge ours chart-tag">Tested by us</span>}</h3>
  <p class="chart-sub">{sub} · {lowerIsBetter ? 'Lower is better' : 'Higher is better'}</p>
  <p class="chart-summary">{summary}</p>
  <div class="bars-wrap">
  {sorted.length === 0 ? (
    <p class="bars-empty">No results yet for the models we track.</p>
  ) : (
    <div class="bars" role="list">
      {sorted.map((r) => (
        <div class={`bar-row${r.muted ? ' is-muted' : ''}`} role="listitem" tabindex="0" title={r.tip ?? `${r.label}: ${r.display ?? r.value}`}>
          <span class="bar-label">{r.href ? <a href={r.href}>{r.label}</a> : r.label}{r.maker && !compact && <span class="maker"> · {r.maker}</span>}</span>
          <span class="bar-track">
            <span class="bar-fill" style={`width:${pct(r.value!)}`}></span>
            {r.low !== undefined && r.high !== undefined && <span class="bar-ci" style={`left:${pct(r.low)};width:calc(${pct(r.high)} - ${pct(r.low)})`}></span>}
            <span class="bar-value" style={`left:${r.high !== undefined ? pct(Math.max(r.high, r.value!)) : pct(r.value!)}`}>{r.display ?? r.value}</span>
          </span>
        </div>
      ))}
      {empty.map((r) => (
        <div class="bar-row is-empty" role="listitem">
          <span class="bar-label">{r.href ? <a href={r.href}>{r.label}</a> : r.label}{r.maker && !compact && <span class="maker"> · {r.maker}</span>}</span>
          <span class="bar-value">Not tested yet</span>
        </div>
      ))}
    </div>
  )}
  {tie && <NormSays text={tie} fromData mood="wise" />}
  </div>
  <div class="chart-foot">
    {source && <>Source: <a href={source.url}>{source.name}</a>{source.note && <> · {source.note}</>}</>}
  </div>
</section>
