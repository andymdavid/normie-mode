---
// Every hub task as a small ranking (its task score for the top three models), with links to its
// more specific tasks so all task pages are one click from here.
import { CLOSENESS_LABEL, subtasksOf, taskPath, taskScores, tasksByDemand } from '../lib/tasks';
interface Props { limit?: number }
const { limit } = Astro.props;
const tasks = tasksByDemand()
  .slice(0, limit)
  .map(({ task }) => ({ task, specific: subtasksOf(task.id).map((s) => s.task), ...taskScores(task) }));
const short = (label: string) => label.replace(/^Best AI for /, '').replace(/^./, (c) => c.toUpperCase());
---
<div class="grid-3 task-grid">
  {tasks.map(({ task, specific, rows, testsUsed, closeness }) => (
    <article class="task-card">
      <h3><a href={taskPath(task)}>{short(task.label)}</a></h3>
      <p class="small">{task.covers}</p>
      <a class="mini-bars" href={taskPath(task)} aria-label={`Top models for ${task.label.toLowerCase()}`}>
        {rows.slice(0, 3).map((r) => (
          <span class="mini-row" title={r.tip}>
            <span class="mini-label">{r.label}</span>
            <span class="bar-track"><span class="bar-fill" style={`width:${Math.max(3, r.value!)}%`}></span></span>
            <span class="mini-value">{r.display}</span>
          </span>
        ))}
      </a>
      <ul class="specific">
        {specific.map((t) => <li><a href={taskPath(t)}>{short(t.label)}</a></li>)}
      </ul>
      <p class="task-foot">
        {closeness ? `${CLOSENESS_LABEL[closeness]} · ${testsUsed} test${testsUsed === 1 ? '' : 's'}` : 'Not tested yet'}
        {task.normie_test && ' · + our own test'}
      </p>
    </article>
  ))}
</div>
<style>
  .task-grid { row-gap: 2.5rem; }
  /* Subgrid keeps title, description, bars, specific tasks and footer aligned across each line. */
  .task-card { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; align-content: start; }
  .task-card h3 { padding-bottom: 0.6rem; border-bottom: 2px solid var(--rule); }
  .task-card h3 a { text-decoration: none; }
  .task-card h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .task-card > .small { margin: 0.6rem 0 0.2rem; color: var(--muted); }
  .mini-bars { display: grid; align-content: start; margin: 0.3rem 0 0.6rem; text-decoration: none; }
  .mini-row { display: grid; grid-template-columns: minmax(7rem, 9.5rem) minmax(0, 1fr) 2.2rem; gap: 0.6rem; align-items: center; font-size: 0.82rem; padding: 0.35rem 0; border-bottom: 1px solid var(--hair); }
  .mini-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini-row .bar-track { height: 8px; margin-right: 0; }
  .mini-value { text-align: right; font: 500 0.8rem var(--mono); }
  .specific { list-style: none; margin: 0 0 0.7rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; align-content: start; }
  .specific li a { display: inline-block; font-size: 0.78rem; padding: 0.15rem 0.5rem; background: var(--band); text-decoration: none; }
  .specific li a:hover { background: var(--lavender); }
  .task-foot { margin: 0; font: 0.7rem var(--mono); text-transform: uppercase; color: var(--muted); }
</style>
