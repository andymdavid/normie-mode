---
// Every everyday task as a small ranking: its task score for the top three models.
import { CLOSENESS_LABEL, subtasksOf, taskPath, taskScores, tasksByDemand } from '../lib/tasks';
interface Props { limit?: number }
const { limit } = Astro.props;
const tasks = tasksByDemand().slice(0, limit).map(({ task }) => ({ task, ...taskScores(task) }));
---
<div class="grid-3 task-grid">
  {tasks.map(({ task, rows, testsUsed, closeness }) => (
    <a class="card task-card" href={taskPath(task)}>
      <h3>{task.label.replace(/^Best AI for /, '').replace(/^./, (c) => c.toUpperCase())}</h3>
      <p class="small">{task.covers}{subtasksOf(task.id).length > 0 && <> Includes {subtasksOf(task.id).map((s) => s.task.label.replace(/^Best AI for /, '')).slice(0, 3).join(', ').toLowerCase()}{subtasksOf(task.id).length > 3 && ' and more'}.</>}</p>
      <div class="mini-bars" aria-label={`Top models for ${task.label.toLowerCase()}`}>
        {rows.slice(0, 3).map((r, i) => (
          <div class="mini-row" title={r.tip}>
            <span class="mini-label">{i + 1}. {r.label}</span>
            <span class="bar-track"><span class="bar-fill" style={`width:${Math.max(3, r.value!)}%`}></span></span>
            <span class="mini-value">{r.display}</span>
          </div>
        ))}
      </div>
      <p class="task-foot">
        {closeness ? `${CLOSENESS_LABEL[closeness]} · ${testsUsed} test${testsUsed === 1 ? '' : 's'}` : 'Not tested yet'}
        {task.normie_test && ' · + our own test'}
      </p>
    </a>
  ))}
</div>
<style>
  .task-grid { row-gap: 2.5rem; }
  /* Subgrid keeps title, description, bars and footer aligned across each line of cards. */
  .task-card { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; align-content: start; background: none; padding: 0; }
  .task-card:hover { background: none; }
  .task-card:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .task-card h3 { padding-bottom: 0.6rem; border-bottom: 2px solid var(--rule); }
  .task-card > .small { margin: 0.6rem 0 0.2rem; color: var(--muted); }
  .mini-bars { display: grid; align-content: start; margin: 0.3rem 0 0.8rem; }
  .mini-row { display: grid; grid-template-columns: minmax(7rem, 9.5rem) minmax(0, 1fr) 2.2rem; gap: 0.6rem; align-items: center; font-size: 0.82rem; padding: 0.35rem 0; border-bottom: 1px solid var(--hair); }
  .mini-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini-row .bar-track { height: 8px; margin-right: 0; }
  .mini-value { text-align: right; font: 500 0.8rem var(--mono); }
  .task-foot { margin: 0; font: 0.7rem var(--mono); text-transform: uppercase; color: var(--muted); }
</style>
