---
// Each job as a small ranking chart: the job score for the top five models (see jobScores).
import { jobScores, jobsInOrder } from '../lib/jobs';
const jobs = jobsInOrder().map((job) => ({ job, ...jobScores(job) }));
---
<div class="grid-3 job-grid">
  {jobs.map(({ job, rows, testsUsed }) => (
    <a class="card job-card" href={`/jobs/${job.id}`}>
      <h3>{job.name}</h3>
      <p class="small muted">{job.covers}</p>
      <div class="mini-bars" aria-label={`Top models for ${job.name.toLowerCase()}`}>
        {rows.slice(0, 5).map((r, i) => (
          <div class="mini-row" title={r.tip}>
            <span class="mini-label">{i + 1}. {r.label}</span>
            <span class="bar-track"><span class="bar-fill" style={`width:${Math.max(3, r.value!)}%`}></span></span>
            <span class="mini-value">{r.display}</span>
          </div>
        ))}
      </div>
      <p class="small muted job-foot">
        Job score from {testsUsed} test{testsUsed === 1 ? '' : 's'}{job.caveat?.startsWith('Based only on people') && ' · people\'s votes only'} · See all →
      </p>
    </a>
  ))}
</div>
<style>
  .job-grid { row-gap: 2.5rem; }
  /* Subgrid: title, description, bars and footer share rows across each line of cards,
     so a longer description in one card keeps every table aligned. */
  .job-card { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; align-content: start; background: none; padding: 0; }
  .job-card:hover { background: none; }
  .job-card:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .job-card h3 { padding-bottom: 0.6rem; border-bottom: 2px solid var(--rule); }
  .job-card > .small { margin: 0.6rem 0 0.2rem; color: var(--muted); }
  .mini-bars { display: grid; margin: 0.3rem 0 0.8rem; }
  .mini-row { display: grid; grid-template-columns: minmax(7rem, 9.5rem) minmax(0, 1fr) 2.2rem; gap: 0.6rem; align-items: center; font-size: 0.82rem; padding: 0.35rem 0; border-bottom: 1px solid var(--hair); }
  .mini-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini-row .bar-track { height: 8px; margin-right: 0; }
  .mini-value { text-align: right; font: 500 0.8rem var(--mono); }
  .job-foot { margin: 0; font: 0.7rem var(--mono); text-transform: uppercase; color: var(--muted); }
</style>
