---
import { jobLeaders, jobsInOrder } from '../lib/jobs';
const jobs = jobsInOrder().map((job) => {
  const { leaders, testsUsed } = jobLeaders(job);
  const min = Math.max(1, Math.ceil(testsUsed / 2));
  return { job, top: leaders.filter((l) => l.tests >= min).slice(0, 2), testsUsed };
});
---
<div class="grid job-grid">
  {jobs.map(({ job, top, testsUsed }) => (
    <a class="card job-card" href={`/jobs/${job.id}`}>
      <h3>{job.name}</h3>
      <p class="small muted">{job.covers}</p>
      <p class="small job-leaders">
        {top.length ? <>Leading: <strong>{top.map((l) => l.model.name).join(', ')}</strong></> : 'Not enough results yet'}
        <span class="muted"> · {testsUsed} test{testsUsed === 1 ? '' : 's'}</span>
      </p>
    </a>
  ))}
</div>
<style>
  .job-card { display: flex; flex-direction: column; }
  .job-card h3 { margin-bottom: 0.3rem; }
  .job-leaders { margin: auto 0 0; padding-top: 0.6rem; border-top: 1px solid var(--line-soft); }
</style>
