---
// Scatter: capability (Epoch index, with its uncertainty) against list-price cost. One series,
// so one colour; identity comes from selective direct labels, the hover layer and the table below.
import type { OverviewRow } from '../lib/overview';
interface Props { rows: OverviewRow[]; label: Set<string> }
const { rows, label } = Astro.props;
const pts = rows.filter((r) => r.eci && r.costPer1000 !== undefined);

const W = 720, H = 400, M = { top: 20, right: 24, bottom: 56, left: 56 };
const xs = pts.map((r) => r.costPer1000!);
const x0 = Math.log10(Math.min(...xs) / 1.6), x1 = Math.log10(Math.max(...xs) * 1.6);
const yLo = Math.floor(Math.min(...pts.map((r) => r.eci!.low)) - 1), yHi = Math.ceil(Math.max(...pts.map((r) => r.eci!.high)) + 1);
const sx = (v: number) => M.left + ((Math.log10(v) - x0) / (x1 - x0)) * (W - M.left - M.right);
const sy = (v: number) => H - M.bottom - ((v - yLo) / (yHi - yLo)) * (H - M.top - M.bottom);
const xTicks = [0.1, 0.3, 1, 3, 10, 30, 100].filter((t) => Math.log10(t) >= x0 && Math.log10(t) <= x1);
const yStep = yHi - yLo > 20 ? 5 : 2;
const yTicks: number[] = [];
for (let t = Math.ceil(yLo / yStep) * yStep; t <= yHi; t += yStep) yTicks.push(t);

// Greedy label placement: right of the dot, else left, else below; drop the label if all collide
// (the hover layer and the table still carry every model).
const CHAR_W = 6.6, LABEL_H = 14;
const placed: { x: number; y: number; w: number }[] = pts.map((r) => ({ x: sx(r.costPer1000!) - 6, y: sy(r.eci!.value) - 6, w: 12 }));
const hits = (a: { x: number; y: number; w: number }) =>
  placed.some((b) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + LABEL_H && b.y < a.y + LABEL_H) || a.x < M.left || a.x + a.w > W;
const labels = new Map<string, { x: number; y: number; anchor: 'start' | 'end' }>();
for (const r of [...pts].sort((a, b) => Number(label.has(b.model.id)) - Number(label.has(a.model.id)))) {
  const cx = sx(r.costPer1000!), cy = sy(r.eci!.value), w = r.model.name.length * CHAR_W;
  for (const c of [
    { x: cx + 9, y: cy - 10, anchor: 'start' as const, box: { x: cx + 9, y: cy - 10 - 10, w } },
    { x: cx - 9, y: cy - 10, anchor: 'end' as const, box: { x: cx - 9 - w, y: cy - 10 - 10, w } },
    { x: cx + 9, y: cy + 16, anchor: 'start' as const, box: { x: cx + 9, y: cy + 16 - 10, w } },
    { x: cx - 9, y: cy + 16, anchor: 'end' as const, box: { x: cx - 9 - w, y: cy + 16 - 10, w } },
  ]) {
    if (!hits(c.box)) { placed.push(c.box); labels.set(r.model.id, c); break; }
  }
}
const money = (v: number) => (v < 1 ? `$${v.toFixed(2)}` : `$${v.toFixed(v < 10 ? 1 : 0)}`);
---
<figure class="viz" data-scatter>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="cc-title cc-desc">
    <title id="cc-title">How capable each model is against what it costs</title>
    <desc id="cc-desc">Scatter chart. Horizontal: cost per 1,000 typical requests, log scale. Vertical: Epoch capability score with uncertainty range. The same data is in the table below.</desc>
    {yTicks.map((t) => (
      <g>
        <line class="grid" x1={M.left} x2={W - M.right} y1={sy(t)} y2={sy(t)} />
        <text class="tick" x={M.left - 8} y={sy(t) + 4} text-anchor="end">{t}</text>
      </g>
    ))}
    {xTicks.map((t) => (
      <g>
        <line class="grid" x1={sx(t)} x2={sx(t)} y1={M.top} y2={H - M.bottom} />
        <text class="tick" x={sx(t)} y={H - M.bottom + 18} text-anchor="middle">{money(t)}</text>
      </g>
    ))}
    <text class="axis-label" x={(M.left + W - M.right) / 2} y={H - 10} text-anchor="middle">Cost per 1,000 typical requests (list price) →  cheaper on the left</text>
    <text class="axis-label" transform={`translate(16 ${(M.top + H - M.bottom) / 2}) rotate(-90)`} text-anchor="middle">Capability score (Epoch AI) → better</text>
    {pts.map((r) => {
      const cx = sx(r.costPer1000!), cy = sy(r.eci!.value);
      const tip = `${r.model.name} · capability ${r.eci!.value.toFixed(1)} (likely ${r.eci!.low.toFixed(0)}–${r.eci!.high.toFixed(0)}) · ${money(r.costPer1000!)} per 1,000 requests`;
      return (
        <g class="pt" tabindex="0" data-tip={tip}>
          <line class="whisker" x1={cx} x2={cx} y1={sy(r.eci!.low)} y2={sy(r.eci!.high)} />
          <circle class="hit" cx={cx} cy={cy} r="14" />
          <circle class="dot" cx={cx} cy={cy} r="5" />
          {labels.has(r.model.id) && (
            <text class="pt-label" x={labels.get(r.model.id)!.x} y={labels.get(r.model.id)!.y} text-anchor={labels.get(r.model.id)!.anchor}>{r.model.name}</text>
          )}
        </g>
      );
    })}
  </svg>
  <div class="viz-tip" hidden></div>
  <figcaption class="small muted">Up and to the left is better. The vertical line on each dot is the likely range: if two lines overlap, it's too close to call.</figcaption>
</figure>
<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-scatter]')) {
    const tip = fig.querySelector<HTMLElement>('.viz-tip')!;
    const show = (el: Element) => {
      const box = el.getBoundingClientRect(), host = fig.getBoundingClientRect();
      tip.textContent = el.getAttribute('data-tip');
      tip.hidden = false;
      tip.style.left = `${Math.min(box.left - host.left + 16, host.width - 260)}px`;
      tip.style.top = `${box.top - host.top - 8}px`;
    };
    for (const pt of fig.querySelectorAll('.pt')) {
      pt.addEventListener('mouseenter', () => show(pt));
      pt.addEventListener('focus', () => show(pt));
      pt.addEventListener('mouseleave', () => (tip.hidden = true));
      pt.addEventListener('blur', () => (tip.hidden = true));
    }
  }
</script>
