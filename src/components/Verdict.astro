---
// The picks at the top of a task page (D-027). Every value comes from `verdict()`; the words only
// say what to get, where to get it and why, in that order.
import { planLabel } from '../lib/plans';
import { ordinal } from '../lib/models';
import { PICK_LABEL, type Option, type Pick, type Verdict } from '../lib/verdict';

interface Props {
  v: Verdict;
  /** A caveat that belongs next to the picks, e.g. what the tests don't cover. */
  note?: string;
}
const { v, note } = Astro.props;
const [lead, ...rest] = v.picks;
const label = (p: Pick) => p.kinds.map((k, i) => (i === 0 ? PICK_LABEL[k] : PICK_LABEL[k].replace(/^Best/, 'best'))).join(', and ');
const price = (usd: number) => (usd === 0 ? 'free' : `$${Number.isInteger(usd) ? usd : usd.toFixed(2)} a month`);
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
/** "Claude Max, $100 a month"; the plan's note, if any, goes after it in brackets, not bold. */
const where = (o: Option) => {
  if (!o.plan) return undefined;
  const name = planLabel(o.plan.app, o.plan.plan);
  // "Claude Free", not "Claude Free, free".
  return o.plan.plan.price_usd === 0 && /free/i.test(name) ? name : `${name}, ${price(o.plan.plan.price_usd)}`;
};
const aside = (o: Option) => (o.plan?.entry.where ? ` (${lower(o.plan.entry.where)})` : '');
/** "Top of 8 models for this task", "4th of 8…", or "2nd and 3rd of 8…" for a tie. */
const reason = (p: Pick) => {
  const [a, b] = p.options;
  const place = b ? `${ordinal(a.position)} and ${ordinal(b.position)}` : a.position === 1 ? 'Top' : ordinal(a.position);
  return `${place} of ${a.of} models for this task`;
};
---
<section class="verdict-block" aria-label="Our picks">
  {[lead, ...rest].length > 0 && (
    <div class="verdict-grid">
      {[lead, ...rest].map((p, i) => (
        <div class={`verdict-pick${i === 0 ? ' is-lead' : ''}`}>
          <span class="verdict-label">{label(p)}{p.options.length > 1 && <span class="verdict-tie">Too close to call</span>}</span>
          {p.options.length === 1 ? (
            <>
              <p class="verdict-model"><a href={`/models/${p.options[0].modelId}`}>{p.options[0].name}</a></p>
              <p class="verdict-action">{where(p.options[0]) ? <>Get it with <strong>{where(p.options[0])}</strong>{aside(p.options[0])}</> : 'Not in any app we cover yet; developers can use it directly.'}</p>
            </>
          ) : (
            <>
              <ul class="verdict-options">
                {p.options.map((o) => (
                  <li>
                    <a class="verdict-option-name" href={`/models/${o.modelId}`}>{o.name}</a>
                    <span class="verdict-action">{where(o) ? <>Get it with <strong>{where(o)}</strong>{aside(o)}</> : 'not in any app we cover yet'}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="verdict-reason">{reason(p)}</p>
        </div>
      ))}
    </div>
  )}
  {note && <p class="verdict-note"><span class="verdict-note-label">Keep in mind</span> {note}</p>}
  <p class="verdict-basis">{v.basis}. The picks follow <a href="/methodology#verdict">a fixed rule</a> using the charts below and each app's plans.</p>

  <details class="verdict-paying">
    <summary>Already paying for one? See what each plan gives you here</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th>App and plan</th><th>Price</th><th>Best model on it for this</th><th>Position</th></tr></thead>
        <tbody>
          {v.plans.map(({ app, plan, best, unscoredDefault }) => (
            <tr>
              <td><strong>{planLabel(app, plan)}</strong></td>
              <td class="num">{price(plan.price_usd)}</td>
              <td>{best ? <><a href={`/models/${best.modelId}`}>{best.name}</a>{best.plan?.entry.where && <div class="small muted">{best.plan.entry.where}</div>}</> : <span class="muted">No score yet</span>}{unscoredDefault && <div class="small muted">Its main model, {unscoredDefault}, is too new to score yet.</div>}</td>
              <td class="num">{best ? `${ordinal(best.position)} of ${best.of}` : '–'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</section>

<style>
  .verdict-block { margin: 2.2rem 0 0; }
  /* Three equal blocks; best overall is marked by colour only, so every block reads the same way:
     label, model name, where to get it, and why (pinned to the bottom so the three line up). */
  .verdict-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: 0.75rem; }
  .verdict-pick { background: var(--band); padding: 1.4rem 1.5rem 1.3rem; display: flex; flex-direction: column; }
  .verdict-pick.is-lead { background: var(--orange); }
  /* Same height with or without the tie tag, so the model names line up across the cards. */
  .verdict-label { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; min-height: 1.3rem; font: 500 0.72rem var(--mono); text-transform: uppercase; margin-bottom: 0.9rem; }
  .verdict-model, .verdict-option-name { font-size: 1.55rem; letter-spacing: -0.025em; line-height: 1.1; }
  .verdict-model { margin: 0 0 0.45rem; }
  .verdict-model a, .verdict-option-name { text-decoration: none; }
  .verdict-model a:hover, .verdict-option-name:hover { text-decoration: underline; }
  .verdict-action { font-size: 0.95rem; line-height: 1.4; margin: 0; }
  .verdict-action strong { font-weight: 600; }
  .verdict-tie { display: inline-block; line-height: 1.2; font: 500 0.7rem/1.2 var(--mono); text-transform: uppercase; background: var(--ink); color: #fff; padding: 0.1rem 0.4rem; }
  .verdict-options { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .verdict-options li { display: grid; gap: 0.45rem; }
  .verdict-reason { font-size: 0.85rem; color: var(--ink-2); margin: auto 0 0; padding-top: 1.2rem; }
  .verdict-reason::before { content: ''; display: block; border-top: 1px solid rgb(0 0 0 / 0.12); margin-bottom: 0.7rem; }
  .verdict-note { margin: 1rem 0 0; font-size: 0.95rem; max-width: 52rem; }
  .verdict-note-label { font: 500 0.7rem var(--mono); text-transform: uppercase; background: var(--ink); color: #fff; padding: 0.1rem 0.4rem; margin-right: 0.4rem; vertical-align: 0.1em; }
  .verdict-basis { font-size: 0.85rem; color: var(--muted); margin: 0.7rem 0 0; }
  .verdict-paying { margin-top: 1.2rem; }
  .verdict-paying summary { cursor: pointer; font-size: 0.95rem; }
  .verdict-paying .table-wrap { margin-top: 1rem; }
</style>
