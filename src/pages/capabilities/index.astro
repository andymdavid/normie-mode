---
import Base from '../../layouts/Base.astro';
import { graph } from '../../lib/graph';
---
<Base title="Skills">
  <div class="eyebrow">Skills</div>
  <h1>The skills behind spreadsheet work</h1>
  <p class="lede">Tests measure skills. Jobs need skills. This is how we connect the two.</p>
  <div class="grid">
    {[...graph().capabilities.values()].map((c) => (
      <a class="card" href={`/capabilities/${c.id}`}><h3>{c.name}</h3><p class="small muted">{c.definition}</p></a>
    ))}
  </div>
</Base>
