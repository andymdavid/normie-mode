---
import Base from '../../layouts/Base.astro';
import Claims from '../../components/Claims.astro';
import ResultsTable from '../../components/ResultsTable.astro';
import { graph } from '../../lib/graph';
import { activeResults } from '../../lib/rules';
import { tasksNeeding } from '../../lib/view';

export function getStaticPaths() {
  return [...graph().capabilities.keys()].map((id) => ({ params: { id } }));
}
const g = graph();
const cap = g.capabilities.get(Astro.params.id!)!;
const benchmarks = [...g.benchmarks.values()]
  .map((b) => ({ b, m: b.measures.find((m) => m.capability === cap.id) }))
  .filter((x) => x.m)
  .sort((a) => (a.m!.strength === 'primary' ? -1 : 1));
const primaryIds = new Set(benchmarks.filter((x) => x.m!.strength === 'primary').map((x) => x.b.id));
// Overall scores only, from benchmarks where this skill is a main focus.
const results = activeResults(g)
  .filter((r) => primaryIds.has(r.benchmark) && !r.subset)
  .sort((a, b) => a.benchmark.localeCompare(b.benchmark) || b.value - a.value);
---
<Base title={`${cap.name}: what AI can do`}>
  <article style="max-width: 46rem">
    <div class="eyebrow">Skills</div>
    <h1>{cap.name}</h1>
    <p class="lede">{cap.definition}</p>
    <h2>Why it matters</h2>
    <p>{cap.why_it_matters}</p>
    {cap.limitations.length > 0 && (<><h2>Where AI still struggles</h2><Claims claims={cap.limitations} /></>)}
    <h2>Jobs that rely on it</h2>
    <ul>
      {tasksNeeding(cap.id).map(({ task, need }) => (
        <li><a href={`/tasks/${task.id}`}>{task.name}</a> <span class="badge plain">{need!.importance === 'core' ? 'Essential' : 'Helpful'}</span></li>
      ))}
    </ul>
    <h2>Tests that measure it</h2>
    <ul>
      {benchmarks.map(({ b, m }) => (
        <li><a href={`/benchmarks/${b.id}`}>{b.name}</a> <span class="badge plain">{m!.strength === 'primary' ? 'Main focus' : 'Partly'}</span></li>
      ))}
    </ul>
  </article>
  {results.length > 0 && (
    <>
      <h2>Results from tests focused on this skill</h2>
      <ResultsTable rows={results.map((result) => ({ result }))} show={{ model: true, benchmark: true }} />
    </>
  )}
</Base>
