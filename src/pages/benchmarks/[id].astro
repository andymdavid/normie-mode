---
// One test explained (D-028): what it checks, how the models we track did, and which tasks use it.
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/BarChart.astro';
import { graph } from '../../lib/graph';
import { rankedTestRows, tasksUsingTest } from '../../lib/models';
import { CLOSENESS_LABEL, leadSentence, taskPath, testFloor, testRows, testSource } from '../../lib/tasks';

export function getStaticPaths() {
  return [...graph().tests.keys()].filter((id) => tasksUsingTest(id).length && rankedTestRows(graph().tests.get(id)!).length).map((id) => ({ params: { id } }));
}
const test = graph().tests.get(Astro.params.id!)!;
const rows = testRows(test);
const tasks = tasksUsingTest(test.id);
const votes = test.source === 'lmarena';
---
<Base title={`${test.title}: the test explained`} description={`${test.what} How the main AI models did, in plain English.`}>
  <div class="eyebrow"><a href="/benchmarks">Tests explained</a> · {votes ? "People's votes" : 'Test of real work'}</div>
  <h1>{test.title}</h1>
  <p class="lede">{test.what}</p>

  <div class="band">
    <div class="band-inner summary-grid">
      <div class="summary"><span class="tag">Run by</span><p><a href={test.url}><strong>{test.by}</strong></a></p></div>
      <div class="summary">
        <span class="tag">How to read it</span>
        <p>{votes
          ? 'A rating from thousands of head-to-head votes. Higher means people preferred its answers more often. The thin line is the likely range.'
          : 'The share of tasks the model got right. The thin line, where shown, is the likely range.'}</p>
      </div>
      <div class="summary"><span class="tag">Used for</span><p><strong>{tasks.length} task{tasks.length === 1 ? '' : 's'}</strong> on this site.</p></div>
    </div>
  </div>

  <BarChart
    title="How the models did"
    sub={votes ? 'Rating from blind votes' : 'Share of tasks done correctly'}
    rows={rows}
    floor={testFloor(test, rows)}
    summary={leadSentence(rows)}
    source={testSource(test)}
  />

  <h2 class="page-h2">Where we use it</h2>
  <p class="section-sub">Each task page labels this test by how closely it matches the task.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Task</th><th>How close</th></tr></thead>
      <tbody>
        {tasks.map(({ task, closeness }) => (
          <tr><td><a href={taskPath(task)}>{task.label}</a></td><td>{CLOSENESS_LABEL[closeness]}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
