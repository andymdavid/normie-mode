---
// How it works (D-028): how a pick is made, shown with the site's own live data. Every number here
// comes from the same functions as the task pages, so the explanation can't drift from the site.
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import Verdict from '../components/Verdict.astro';
import { graph } from '../lib/graph';
import { imported } from '../lib/imported';
import { CLOSENESS_LABEL, MIN_MODELS_TO_RANK, allTaskPages, effectiveTests, leaders, ordinal, taskPath, taskScores, testRows, topTwoTied } from '../lib/tasks';
import { EVIDENCE_STATUS_LABEL, TESTED_THRESHOLD, TYPICAL_REQUEST, overviewRows } from '../lib/overview';
import { comparedModels, formatPrice, planLabel, visibleApps } from '../lib/plans';
import { rankedTestRows, tasksUsingTest } from '../lib/models';
import { STANDARD_PLAN_MAX_USD, TOO_CLOSE_POINTS, verdict } from '../lib/verdict';
import { PLAN_MAX_AGE_DAYS } from '../lib/rules';
import { formatDate } from '../lib/view';

const g = graph();
const { epoch, modelsdev, lmarena } = imported();
const models = comparedModels();
const tests = [...g.tests.values()].filter((t) => tasksUsingTest(t.id).length && rankedTestRows(t).length);
const apps = visibleApps();
const planCount = apps.reduce((n, a) => n + a.plans.length, 0);
const pages = allTaskPages();

// Worked example: the most-searched task, "coding and building apps".
const example = g.intents.get('coding')!;
const exampleName = example.label.replace(/^Best AI for /, '');
const { leaders: exLeaders, placements, used } = leaders(example);
const exRows = taskScores(example).rows;
const exTop = exRows.slice(0, 4);
const exVerdict = verdict(example);
const pct = (v?: number) => (v === undefined ? '–' : (v * 100).toFixed(0));

// "Too close to call": the first test with an overlapping top two.
const tieTest = tests.find((t) => topTwoTied(testRows(t)));
const tieRows = tieTest ? rankedTestRows(tieTest).slice(0, 4) : [];

const sources = [
  { name: 'Epoch AI', gives: 'Results from independent tests of real work, like fixing code or answering expert questions', count: `${tests.filter((t) => t.source === 'epoch').length} tests`, licence: epoch?.meta.licence, url: epoch?.meta.url, date: epoch?.meta.retrieved_at },
  { name: 'LMArena', gives: 'People comparing two anonymous answers and picking the better one', count: `${tests.filter((t) => t.source === 'lmarena').length} vote categories`, licence: lmarena?.meta.licence, url: lmarena?.meta.url, date: lmarena?.meta.as_of },
  { name: 'models.dev', gives: 'Prices, release dates and how much each model can read', count: `${models.length} models`, licence: modelsdev?.meta.licence, url: modelsdev?.meta.url, date: modelsdev?.meta.retrieved_at },
  { name: "Makers' own pages", gives: 'Which plans include which model, and what makers claim at launch (always labelled)', count: `${apps.length} apps, ${planCount} plans`, licence: 'Cited', url: undefined, date: apps[0]?.checked_on },
];

const closenessUse = (['direct', 'related', 'general'] as const).map((c) => ({
  c,
  pages: pages.filter((p) => taskScores(p).closeness === c).length,
}));
const statusCounts = (['tested', 'early', 'maker-says'] as const).map((s) => ({ s, n: overviewRows().filter((r) => r.status === s).length }));
const sections = [
  ['flow', 'From test to pick'],
  ['sources', 'Where the evidence comes from'],
  ['closeness', 'How close a test is'],
  ['score', 'The task score'],
  ['verdict', 'The picks'],
  ['close', 'Too close to call'],
  ['new', 'New models'],
  ['plans', 'Apps and plans'],
  ['words', 'Who writes what'],
  ['limits', "What it can't tell you"],
];
---
<Base title="How it works" description="How Normie Mode turns independent AI tests and people's votes into a pick for your task, shown step by step with real data.">
  <div class="eyebrow">How it works</div>
  <h1>How it works</h1>
  <p class="lede">We turn independent tests and people's votes into a pick for your task, then tell you which app and plan gets it. Here's each step, using the site's own data.</p>

  <div class="band">
    <div class="band-inner summary-grid">
      <div class="summary"><span class="tag">Models compared</span><p><strong>{models.length}</strong> from Anthropic, OpenAI, Google, DeepSeek and Moonshot AI.</p></div>
      <div class="summary"><span class="tag">Tests and vote categories</span><p><strong>{tests.length}</strong>, each explained on <a href="/benchmarks">Tests explained</a>.</p></div>
      <div class="summary"><span class="tag">Everyday tasks</span><p><strong>{pages.length}</strong> task pages, named after what people search for.</p></div>
      <div class="summary"><span class="tag">Last updated</span><p><strong>{formatDate(epoch?.meta.retrieved_at.slice(0, 10))}</strong>. Plans checked {formatDate(apps[0]?.checked_on)}.</p></div>
    </div>
  </div>

  <div class="with-toc">
    <nav class="toc" aria-label="On this page"><ol>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
    <div>
      <div class="section-head" id="flow" style="margin-top:0"><h2>From test to pick</h2></div>
      <p class="section-sub">Four steps, shown for <a href={taskPath(example)}>{exampleName}</a>, the task people search for most.</p>
      <ol class="flow">
        <li>
          <span class="flow-n">1</span>
          <h3>Gather the evidence</h3>
          <p>Tests and votes that measure the task, each labelled by how closely it matches.</p>
          <p class="flow-example">{used.length} tests for {exampleName}</p>
        </li>
        <li>
          <span class="flow-n">2</span>
          <h3>Score each model</h3>
          <p>Combine its place on every test into one task score.</p>
          <p class="flow-example">{exRows[0]?.label} comes {ordinal(1)} of {exRows.length}</p>
        </li>
        <li>
          <span class="flow-n">3</span>
          <h3>Make the picks</h3>
          <p>Best overall, best for ${STANDARD_PLAN_MAX_USD} a month or less, and best free.</p>
          <p class="flow-example">{exVerdict?.picks.length ?? 0} picks</p>
        </li>
        <li>
          <span class="flow-n">4</span>
          <h3>Match to a plan</h3>
          <p>Find the cheapest app and plan that includes each pick.</p>
          <p class="flow-example">{exVerdict?.picks[0]?.options[0]?.plan ? `${planLabel(exVerdict.picks[0].options[0].plan.app, exVerdict.picks[0].options[0].plan.plan)}, ${formatPrice(exVerdict.picks[0].options[0].plan.plan.price_usd)}` : 'No plan yet'}</p>
        </li>
      </ol>

      <div class="section-head" id="sources"><h2>Where the evidence comes from</h2></div>
      <p class="section-sub">Free, public sources whose licences let us show their data. Every chart names its source underneath.</p>
      <div class="source-grid">
        {sources.map((src) => (
          <div class="source">
            <h3>{src.url ? <a href={src.url}>{src.name}</a> : src.name}</h3>
            <p>{src.gives}</p>
            <dl>
              <dt>We use</dt><dd>{src.count}</dd>
              <dt>Licence</dt><dd>{src.licence}</dd>
              <dt>As of</dt><dd>{formatDate(src.date?.slice(0, 10))}</dd>
            </dl>
          </div>
        ))}
      </div>

      <div class="section-head" id="closeness"><h2>How close a test is to your task</h2></div>
      <p class="section-sub">Hardly any test measures an everyday task exactly, so every test on a task page carries one of three labels.</p>
      <div class="closeness">
        {closenessUse.map(({ c, pages: n }) => (
          <div class={`closeness-item is-${c}`}>
            <span class="tag">{CLOSENESS_LABEL[c]}</span>
            <p>{c === 'direct' ? 'The test is this kind of work.' : c === 'related' ? 'It tests a skill the task depends on.' : 'It tests overall ability. Used only when nothing closer exists.'}</p>
            <p class="closeness-count">{n} task page{n === 1 ? '' : 's'} rest mainly on this</p>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:1rem">A more specific task, like vibe coding, borrows its broader task's tests when it has none of its own, labelled as related at most.</p>

      <div class="section-head" id="score"><h2>The task score</h2></div>
      <p class="section-sub">On each test, the lowest of our models is placed at 0 and the highest at 100. A model's task score is the average of its places. Here's how the top of {exampleName} is worked out:</p>
      <div class="table-wrap">
        <table class="breakdown">
          <thead>
            <tr>
              <th>Model</th>
              {used.map((t) => <th><a href={`/benchmarks/${t.id}`}>{t.title}</a><div class="th-note">{CLOSENESS_LABEL[effectiveTests(example).find((x) => x.test === t.id)!.closeness]}</div></th>)}
              <th>Task score</th>
            </tr>
          </thead>
          <tbody>
            {exTop.map((r, i) => (
              <tr>
                <td><strong>{r.label}</strong><div class="small muted">{ordinal(i + 1)}</div></td>
                {used.map((t) => <td class="num">{pct(placements.get(r.id)?.get(t.id))}</td>)}
                <td class="num"><strong>{r.value!.toFixed(0)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="rules">
        <li><strong>It's relative.</strong> It shows who leads among the models we track, not how good they are in absolute terms. Last place isn't useless.</li>
        <li><strong>A test needs at least {MIN_MODELS_TO_RANK} of our models</strong> before it counts, so two results can't decide a ranking.</li>
        <li><strong>A model needs results on at least half the tests</strong>, including at least one test of real work when the task has one. People's votes alone can't put a model on the chart.</li>
        <li><strong>A dash</strong> means the model hasn't taken that test; its score averages the tests it has.</li>
      </ul>
      <p class="small muted">{exLeaders.length - exRows.length > 0 ? `${exLeaders.length - exRows.length} more model${exLeaders.length - exRows.length === 1 ? ' has' : 's have'} some results for ${exampleName} but not enough to score yet.` : ''}</p>

      <div class="section-head" id="verdict"><h2>The picks</h2></div>
      <p class="section-sub">Every task page opens with picks made by a fixed rule, so they always agree with the charts:</p>
      <ul class="rules">
        <li><strong>Best overall:</strong> the highest task score, and the cheapest plan that includes it.</li>
        <li><strong>Best for ${STANDARD_PLAN_MAX_USD} a month or less:</strong> the highest-scoring model on a plan at that price or below.</li>
        <li><strong>Best free:</strong> the highest-scoring model on a free plan.</li>
        <li><strong>Within {TOO_CLOSE_POINTS} points:</strong> we name both and put the cheaper plan first.</li>
        <li><strong>Extra cost doesn't count.</strong> A model you pay for on top of a plan isn't treated as included.</li>
      </ul>
      {exVerdict && (
        <>
          <p class="section-sub" style="margin-top:2rem">Here's the result for {exampleName}:</p>
          <Verdict v={exVerdict} />
        </>
      )}

      <div class="section-head" id="close"><h2>Too close to call</h2></div>
      <p class="section-sub">Results come with a likely range, drawn as a thin line on each bar. When the top two lines overlap, we say it's too close to call rather than naming a winner.</p>
      {tieTest && (
        <BarChart title={tieTest.title} sub="An example from the site" rows={tieRows} floor={Math.floor((Math.min(...tieRows.map((r) => r.low ?? r.value!)) - 25) / 25) * 25} tieNote={true} />
      )}

      <div class="section-head" id="new"><h2>New models</h2></div>
      <p class="section-sub">Independent testers take one to three weeks to catch up with a launch, so each model shows where its evidence stands. A new version always starts from nothing; we never assume it performs like the one before.</p>
      <div class="closeness">
        {statusCounts.map(({ s, n }) => (
          <div class="closeness-item">
            <span class={`badge status-${s}`}>{EVIDENCE_STATUS_LABEL[s]}</span>
            <p>{s === 'maker-says' ? 'No independent results yet, only what the maker says.' : s === 'early' ? `Fewer than ${TESTED_THRESHOLD} independent results.` : `${TESTED_THRESHOLD} or more, or a place on Epoch AI's combined score.`}</p>
            <p class="closeness-count">{n} model{n === 1 ? '' : 's'} right now</p>
          </div>
        ))}
      </div>

      <div class="section-head" id="plans"><h2>Apps and plans</h2></div>
      <p class="section-sub">ChatGPT, Claude and Gemini are apps; each runs one or more models, and free plans often run an older one. We compare the models, then map each to the plans that include it.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>App</th><th>Plans we cover</th><th>Checked</th></tr></thead>
          <tbody>
            {apps.map((a) => (
              <tr>
                <td><a href={a.url}><strong>{a.app}</strong></a><div class="small muted">{a.maker}</div></td>
                <td>{a.plans.map((p) => `${p.name} (${formatPrice(p.price_usd)})`).join(', ')}</td>
                <td class="small">{formatDate(a.checked_on)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="rules">
        <li>We check plans against the makers' own pages at least every {PLAN_MAX_AGE_DAYS} days. Where a maker's page can't be read, we use press coverage and say so.</li>
        <li>An older model that a plan still uses stays on our charts, because it's what people on that plan actually get.</li>
        <li>Plans change often, so check the price before you buy.</li>
      </ul>
      <p class="small muted">Cost charts show what developers pay to use a model directly, for 1,000 typical requests of about {TYPICAL_REQUEST.words}. If you use an app, the monthly plan is what you pay.</p>

      <div class="section-head" id="words"><h2>Who writes what</h2></div>
      <div class="words">
        <div class="norm-card">
          <img src="/norm-wise.jpg" alt="" width="72" height="72" />
          <div>
            <h3>Norm, our guide</h3>
            <p>Anything Norm says about the data, like who leads or what the top models cost, is filled in from the same numbers as the charts, so it can't disagree with them. His advice is written by a person and only appears once it's been reviewed.</p>
          </div>
        </div>
        <div>
          <h3>What the makers say</h3>
          <p>Launch claims appear on model pages, always labelled as the maker's own, and never count towards a score.</p>
        </div>
      </div>

      <div class="section-head" id="limits"><h2>What it can't tell you</h2></div>
      <ul class="rules">
        <li><strong>How good AI is at your exact job.</strong> Tests are close stand-ins, and the label on each chart tells you how close.</li>
        <li><strong>Whether one answer is right.</strong> Every model makes mistakes; Norm's guide on each task says what to check.</li>
        <li><strong>How a model does inside a specific app feature</strong>, like a document upload or a coding tool. We compare the models, not the apps.</li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr)); gap: 1px; background: var(--hair); counter-reset: none; }
  .flow li { background: var(--band); padding: 1.2rem 1.3rem 1.3rem; display: grid; grid-template-rows: auto auto 1fr auto; position: relative; }
  .flow li:first-child { background: var(--orange); }
  .flow-n { font: 500 0.72rem var(--mono); margin-bottom: 0.8rem; }
  .flow h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .flow p { font-size: 0.9rem; margin: 0; }
  .flow .flow-example { margin-top: 1rem; padding-top: 0.7rem; border-top: 1px solid rgba(0, 0, 0, 0.15); font: 0.78rem var(--mono); }
  .source-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: 1.5rem; }
  .source h3 { font-size: 1.15rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--rule); margin-bottom: 0.7rem; }
  .source h3 a { text-decoration: none; }
  .source p { font-size: 0.9rem; color: var(--ink-2); min-height: 3.6em; }
  .source dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 0.8rem; margin: 0.8rem 0 0; font-size: 0.85rem; }
  .source dt { font: 500 0.68rem var(--mono); text-transform: uppercase; color: var(--muted); padding-top: 0.15rem; }
  .source dd { margin: 0; }
  .closeness { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); gap: 1px; background: var(--hair); }
  .closeness-item { background: var(--page); padding: 1.1rem 1.2rem 1.2rem 0; }
  .closeness-item + .closeness-item { padding-left: 1.2rem; }
  .closeness-item .tag { display: block; font: 500 0.72rem var(--mono); text-transform: uppercase; margin-bottom: 0.6rem; }
  .closeness-item p { font-size: 0.92rem; margin: 0.4rem 0 0; }
  .closeness-count { font: 0.78rem var(--mono); color: var(--muted); }
  .breakdown th { vertical-align: bottom; min-width: 7rem; }
  .breakdown th a { color: var(--ink); text-transform: none; font: 500 0.8rem var(--sans); }
  .th-note { font: 0.64rem var(--mono); color: var(--muted); margin-top: 0.25rem; }
  .rules { list-style: none; margin: 1.5rem 0 0.8rem; padding: 0; border-top: 2px solid var(--rule); max-width: 46rem; }
  .rules li { padding: 0.7rem 0; border-bottom: 1px solid var(--hair); font-size: 0.95rem; }
  .words { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 2rem; margin-top: 1rem; }
  .words h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .words p { font-size: 0.95rem; color: var(--ink-2); }
  .norm-card { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .norm-card img { border-radius: 50%; }
</style>
