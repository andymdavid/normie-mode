---
// Our own test's results page ("Tested by us"): every question, answer and score, published.
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/BarChart.astro';
import { graph } from '../../lib/graph';
import { makerOf, taskPath } from '../../lib/tasks';
import { tasksUsingTest } from '../../lib/models';
import { expectedAnswer, formatAnswer, givenAnswer, publishedRun, rankRun, runDates } from '../../lib/normie-tests';
import { toCsv } from '../../../evals/spreadsheet-questions/suite';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DATASET_PUBLICATIONS, datasetVisible } from '../../lib/dataset-publication';

export function getStaticPaths() {
  return [...graph().tests.values()].filter((t) => t.source === 'normie' && publishedRun(t.key)).map((t) => ({ params: { suite: t.key } }));
}

const g = graph();
const run = publishedRun(Astro.params.suite!)!;
const { summary, cases, answers } = run;
const questions = cases[0].questions;
const model = (id: string) => g.models.get(id)!;
const perModel = summary.models.map((m) => {
  const mine = answers.filter((a) => a.model === m.model);
  const correct = mine.reduce((s, a) => s + a.score.correct, 0);
  const total = mine.reduce((s, a) => s + a.score.total, 0);
  return { ...m, correct, total, perQuestion: Object.fromEntries(questions.map((q) => [q.id, mine.filter((a) => a.score.per_question[q.id]).length])) };
});
const base = (m: (typeof perModel)[number]) => ({ id: m.model, label: m.name, maker: makerOf(model(m.model)), href: `/models/${m.model}` });
const scoreRows = perModel.map((m) => ({ ...base(m), value: m.correct, display: `${m.correct}/${m.total}`, tip: `${m.name}: ${m.correct} of ${m.total} answers right` }));
const costRows = perModel.map((m) => ({ ...base(m), value: m.cost_usd, display: `$${m.cost_usd.toFixed(2)}`, tip: `${m.name}: $${m.cost_usd.toFixed(3)} for all ${cases.length} sheets` }));
const timeRows = perModel.map((m) => ({ ...base(m), value: m.avg_seconds ?? undefined, display: m.avg_seconds ? `${Math.round(m.avg_seconds)}s` : undefined }));

const ranked = rankRun(run);
const test = [...g.tests.values()].find((t) => t.source === 'normie' && t.key === Astro.params.suite)!;
const usedBy = tasksUsingTest(test.id);
const perfect = perModel.filter((m) => m.correct === m.total).sort((a, b) => a.cost_usd - b.cost_usd);
const misses = answers
  .flatMap((a) => questions.filter((q) => !a.score.per_question[q.id]).map((q) => ({ a, q, c: cases.find((c) => c.id === a.case)! })))
  .map(({ a, q, c }) => ({ model: model(a.model).name, sheet: a.case.replace('case-0', 'Sheet '), question: c.questions.find((x) => x.id === q.id)!, given: givenAnswer(a, c.questions.find((x) => x.id === q.id)!) }));
const sheet = cases[0];
const sheetAnswers = perModel.map((m) => ({ m, a: answers.find((x) => x.model === m.model && x.case === sheet.id)! }));
const csvLines = toCsv(sheet.orders).split('\n');
const runDate = runDates(run);
const showDataset = datasetVisible(test.key);
const datasetPublication = DATASET_PUBLICATIONS[test.key];
const datasetJsonLd = showDataset ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: test.title,
  description: test.what,
  url: new URL(`/tests/${test.key}`, Astro.site),
  identifier: `normie-mode:${test.key}:v${summary.version ?? '1'}`,
  version: summary.version ?? '1',
  datePublished: test.published_on,
  creator: { '@type': 'Organization', name: 'Normie Mode', url: Astro.site },
  isAccessibleForFree: true,
  ...(datasetPublication?.licence ? { license: datasetPublication.licence.url } : {}),
  ...(datasetPublication?.licence ? { conditionsOfAccess: datasetPublication.licence.scope } : {}),
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL(`/datasets/${test.key}.json`, Astro.site) },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(`/datasets/${test.key}.csv`, Astro.site) },
  ],
  measurementTechnique: 'Fixed synthetic spreadsheet cases with automatically scored questions',
  variableMeasured: ['Answer correctness', 'Cost', 'Response time'],
}) : undefined;
---
<Base title="AI spreadsheet test: business questions" description={`Results from our reproducible test of ${perModel.length} AI models answering business questions from a spreadsheet, with every question and answer published.`}>
  {datasetJsonLd && <script type="application/ld+json" set:html={datasetJsonLd} />}
  <Breadcrumbs items={[
    { label: 'Tests explained', href: '/benchmarks' },
    { label: 'Tested by us', badge: 'ours' },
    { label: 'Business questions from a spreadsheet' },
  ]} />
  <h1>Can AI answer business questions from a spreadsheet?</h1>
  <p class="lede">We gave {perModel.length} AI models the same sales sheets and asked the questions a manager would ask. Every question has one right answer, so no one had to judge.</p>

  <div class="band">
    <div class="band-inner summary-grid">
      <div class="summary"><span class="tag">The short answer · Measured result</span><p><strong>Yes, mostly.</strong> {perfect.length} of {perModel.length} models got every answer right. The rest made the most dangerous kind of mistake: a confident, plausible wrong number.</p></div>
      <div class="summary"><span class="tag">Every answer right</span><p>{perfect.length ? <>{perfect.map((m, i) => <>{i > 0 && (i === perfect.length - 1 ? ' and ' : ', ')}<strong>{m.name}</strong></>)}.</> : 'No model.'}</p></div>
      <div class="summary"><span class="tag">What to check</span><p>When models got it wrong, they named the right customer or product but gave the <strong>wrong amount</strong>. Always sanity-check the numbers.</p></div>
      <div class="summary"><span class="tag">Test details</span><p>{cases.length} sheets × {questions.length} questions × {perModel.length} models, run {runDate}. Total cost to run: <strong>${summary.total_cost_usd.toFixed(2)}</strong>.</p></div>
    </div>
  </div>

  <section class="counts" aria-labelledby="counts-h">
    <h2 class="page-h2" id="counts-h">Where this test counts</h2>
    <p class="section-sub">It's one of the tests behind the task score and picks on {usedBy.length === 1 ? 'this page' : 'these pages'}, marked "Tests this task". The picks there combine it with the other evidence.</p>
    <ul class="counts-list">{usedBy.map(({ task }) => <li><a href={taskPath(task)}>{task.label}</a></li>)}</ul>
  </section>

  <div class="section-head"><h2>How each model did</h2></div>
  <p class="section-sub">Most answers right first. In the task score, models with the same number right score the same; cost and speed are shown for information.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Model</th><th>Answers right</th><th>Cost (5 sheets)</th><th>Time per sheet</th></tr></thead>
      <tbody>
        {ranked.map((r) => (
          <tr>
            <td><a href={`/models/${r.model}`}><strong>{r.name}</strong></a><div class="small muted">{makerOf(model(r.model))}</div></td>
            <td class="num">{r.correct}/{r.total}</td>
            <td class="num">${r.cost.toFixed(2)}</td>
            <td class="num">{Math.round(r.seconds)}s</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="section-head"><h2>Results</h2></div>
  <p class="section-sub">Each model answered the same {cases.length * questions.length} questions.</p>
  <div class="grid-3">
    <BarChart compact title="Answers right" sub={`Out of ${cases.length * questions.length}`} rows={scoreRows} showEmpty={false} />
    <BarChart compact title="What it cost" sub={`For all ${cases.length} sheets`} rows={costRows} lowerIsBetter showEmpty={false} />
    <BarChart compact title="How long it took" sub="Average per sheet" rows={timeRows} lowerIsBetter showEmpty={false} />
  </div>

  <div class="section-head"><h2>Question by question</h2></div>
  <p class="section-sub">How many of the {cases.length} sheets each model got right, for each question.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Question</th>{perModel.map((m) => <th>{m.name}</th>)}</tr></thead>
      <tbody>
        {questions.map((q) => (
          <tr>
            <td>{q.plain}</td>
            {perModel.map((m) => {
              const n = m.perQuestion[q.id];
              return <td class="num">{n === cases.length ? '✓ ' : '✗ '}{n}/{cases.length}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="section-head"><h2>Where it went wrong</h2></div>
  <p class="section-sub">Every wrong answer, next to the right one.</p>
  {misses.length === 0 ? <p class="card">No mistakes.</p> : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Model</th><th>Sheet</th><th>Question</th><th>Right answer</th><th>It said</th></tr></thead>
        <tbody>
          {misses.map((x) => (
            <tr><td>{x.model}</td><td>{x.sheet}</td><td>{x.question.plain}</td><td class="num">{expectedAnswer(x.question)}</td><td class="num">{formatAnswer(x.question, x.given)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div class="section-head"><h2>See it for yourself</h2></div>
  <p class="section-sub">Sheet 1: what we asked, and what every model answered.</p>
  <div class="grid-2">
    <div class="card">
      <h3>The questions</h3>
      <ol class="small">{questions.map((q) => <li>{q.text}</li>)}</ol>
      <p class="small muted">The definitions we gave: an order's value is quantity × unit price minus the discount; net revenue only counts completed orders.</p>
    </div>
    <div class="card">
      <h3>The sheet</h3>
      <p class="small muted">{sheet.orders.length} orders, including discounts, refunds and cancellations.</p>
      <details>
        <summary class="small">Show the first 12 rows</summary>
        <div class="table-wrap" style="margin-top:0.5rem">
          <table>
            <thead><tr>{csvLines[0].split(',').map((h) => <th>{h.replace(/_/g, ' ')}</th>)}</tr></thead>
            <tbody>{csvLines.slice(1, 13).map((l) => <tr>{l.split(',').map((v) => <td>{v}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </details>
    </div>
  </div>
  <div class="table-wrap" style="margin-top:0.9rem">
    <table>
      <thead><tr><th>Question</th><th>Right answer</th>{sheetAnswers.map(({ m }) => <th>{m.name}</th>)}</tr></thead>
      <tbody>
        {sheet.questions.map((q) => (
          <tr>
            <td>{q.plain}</td>
            <td class="num">{expectedAnswer(q)}</td>
            {sheetAnswers.map(({ a }) => <td class="num">{a.score.per_question[q.id] ? '✓ ' : '✗ '}{formatAnswer(q, givenAnswer(a, q))}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {showDataset && (
    <section class="dataset-card" aria-labelledby="dataset-heading">
      <span class="tag">Reusable data</span>
      <h2 id="dataset-heading">Download the complete test</h2>
      <p>The files include all five synthetic sheets, exact prompts and answer keys, every model response, question-level scores, model routes, providers, costs, timings and token usage.</p>
      <p class="dataset-links"><a href={`/datasets/${test.key}.json`} download>Complete JSON</a><a href={`/datasets/${test.key}.csv`} download>Question-level CSV</a></p>
      {datasetPublication?.licence ? (
        <p class="small muted">Licence: <a href={datasetPublication.licence.url}>{datasetPublication.licence.name}</a>. {datasetPublication.licence.scope}</p>
      ) : (
        <p class="small muted"><strong>Preview only:</strong> reuse terms have not been approved, so these files are not published and no public licence is granted yet.</p>
      )}
      <p class="small muted"><strong>Suggested citation:</strong> Normie Mode (2026), “Answering business questions from a spreadsheet”, version {summary.version ?? '1'}, <span class="mono">normiemode.com/tests/{test.key}</span>.</p>
    </section>
  )}

  <div class="section-head"><h2>How we tested</h2></div>
  <ul class="small muted" style="max-width:46rem">
    <li>Every model got identical sheets and instructions, through OpenRouter at its default settings, once per sheet.</li>
    <li>The sheets are made-up but realistic sales data, pasted as text. This doesn't test working with real Excel files, formulas or charts.</li>
    <li>Money answers count as right within 0.5% or £1; names must match the sheet.</li>
    <li>One run per sheet, so small differences may be luck.</li>
  </ul>
</Base>

<style>
  .counts { margin-top: 1rem; }
  .counts-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .counts-list a { font-size: 1.05rem; }
  .dataset-card { margin: 2.5rem 0; padding: 1.25rem; background: var(--band); max-width: 58rem; }
  .dataset-card h2 { margin: 0.45rem 0 0.6rem; }
  .dataset-card p { max-width: 50rem; }
  .dataset-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .dataset-links a { display: inline-block; padding: 0.55rem 0.75rem; color: white; background: var(--navy); font-weight: 600; text-decoration: none; }
</style>
