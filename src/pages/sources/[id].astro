---
import Base from '../../layouts/Base.astro';
import { graph } from '../../lib/graph';
import { EVIDENCE_CLASS_LABEL, formatDate } from '../../lib/view';

export function getStaticPaths() {
  return [...graph().sources.keys()].map((id) => ({ params: { id } }));
}
const g = graph();
const s = g.sources.get(Astro.params.id!)!;
const results = [...g.results.values()].filter((r) => r.source === s.id);
const benchmarks = [...g.benchmarks.values()].filter((b) => b.sources.includes(s.id));
---
<Base title={s.title} noindex>
  <article style="max-width: 46rem">
    <div class="eyebrow">Source · {EVIDENCE_CLASS_LABEL[s.evidence_class]}</div>
    <h1 style="font-size: 1.9rem">{s.title}</h1>
    {s.status !== 'active' && <div class="flag">This source has been {s.status}.{s.superseded_by && <> See <a href={`/sources/${s.superseded_by}`}>the replacement</a>.</>}</div>}
    <dl class="facts card">
      <dt>Publisher</dt><dd>{s.publisher}</dd>
      <dt>Type</dt><dd>{EVIDENCE_CLASS_LABEL[s.evidence_class]}</dd>
      <dt>Published</dt><dd>{formatDate(s.published_on)}</dd>
      <dt>We retrieved it</dt><dd>{formatDate(s.retrieved_on)}</dd>
      <dt>Link</dt><dd><a href={s.url} rel="noopener">{s.url}</a></dd>
    </dl>
    {s.notes && <><h2>Notes</h2><p>{s.notes}</p></>}
    {benchmarks.length > 0 && <p>Describes: {benchmarks.map((b) => <a href={`/benchmarks/${b.id}`}>{b.name}</a>)}</p>}
    {results.length > 0 && <p>{results.length} result{results.length === 1 ? '' : 's'} on this site come from this source.</p>}
  </article>
</Base>
