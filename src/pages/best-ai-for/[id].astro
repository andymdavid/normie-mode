---
// A task page (D-025): one everyday need people search for, the evidence for it, and Norm's guide.
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/BarChart.astro';
import NormSays from '../../components/NormSays.astro';
import { graph } from '../../lib/graph';
import { latestRun, rankRun } from '../../lib/normie-tests';
import { overviewRows } from '../../lib/overview';
import { CLOSENESS_LABEL, leadSentence, normLine, taskPath, taskScores, tasksByDemand, testFloor, testRows, testSource } from '../../lib/tasks';
import { PREVIEW, formatDate } from '../../lib/view';

export function getStaticPaths() {
  return tasksByDemand().map(({ task }) => ({ params: { id: task.id } }));
}

const g = graph();
const task = g.intents.get(Astro.params.id!)!;
const name = task.label.replace(/^Best AI for /, '');
const scores = taskScores(task);
const top = scores.rows.slice(0, 3);
const evidence = task.tests
  .map((t) => ({ ...t, test: g.tests.get(t.test)!, rows: testRows(g.tests.get(t.test)!) }))
  .filter((e) => e.rows.some((r) => r.value !== undefined));
const noResults = task.tests.filter((t) => !evidence.some((e) => e.test.id === t.test)).map((t) => g.tests.get(t.test)!);
const ownRun = PREVIEW && task.normie_test ? latestRun(task.normie_test) : undefined;
const norm = task.norm;
const normOn = !!norm && (norm.status === 'approved' || PREVIEW);
const scoreNorm = normLine(scores.closeness === 'direct' ? 'task_score' : scores.closeness === 'related' ? 'related_only' : 'general_only');
const hasWhiskers = evidence.some((e) => e.rows.some((r) => r.low !== undefined));
const costRows = overviewRows().map((r) => ({
  id: r.model.id, label: r.model.name, maker: r.maker, href: `/models/${r.model.id}`,
  value: r.costPer1000, display: r.costPer1000 === undefined ? undefined : `$${r.costPer1000 < 10 ? r.costPer1000.toFixed(2) : r.costPer1000.toFixed(0)}`,
}));
const others = tasksByDemand().filter((t) => t.task.id !== task.id).slice(0, 3);
const month = formatDate(new Date().toISOString().slice(0, 10)).replace(/^\d+ /, '');
const leaderLine = top.length
  ? `On the tests we have, ${top[0].label} comes out on top${top[1] ? `, followed by ${top.slice(1).map((r) => r.label).join(' and ')}` : ''}.`
  : undefined;
const sections = [['answer', 'The short answer'], ...(normOn ? [['guide', "Norm's guide"]] : []), ['evidence', 'The evidence'], ['cost', 'What it costs']];
---
<Base
  title={`${task.label} (${month})`}
  description={`${task.label}: which AI models do best at ${task.covers?.toLowerCase().replace(/\.$/, '')}, what to watch out for, and the evidence behind it.`}
>
  <div class="eyebrow"><a href="/best-ai-for">Best AI for…</a></div>
  <h1>{task.label}</h1>
  <p class="lede">{task.covers}</p>
  {norm && <NormSays text={norm.intro} status={norm.status} />}

  <div class="band">
    <div class="band-inner summary-grid">
      <div class="summary">
        <span class="tag">Top of the tests</span>
        <p>{top.length ? top.map((r, i) => (<>{i > 0 && (i === top.length - 1 ? ' and ' : ', ')}<strong>{r.label}</strong></>)) : 'Not enough results yet.'}</p>
      </div>
      <div class="summary">
        <span class="tag">How close the evidence is</span>
        <p>{scores.closeness ? <><strong>{CLOSENESS_LABEL[scores.closeness]}.</strong> {scores.testsUsed} test{scores.testsUsed === 1 ? '' : 's'} with results.</> : 'Nothing measures this yet.'}</p>
      </div>
      {task.coverage === 'gap' && (
        <div class="summary"><span class="tag">Not tested properly yet</span><p>No test measures this task directly yet. It's on our list.</p></div>
      )}
      {task.note && <div class="summary"><span class="tag">Keep in mind</span><p>{task.note}</p></div>}
    </div>
  </div>

  <div class="with-toc">
    <nav class="toc" aria-label="On this page"><ol>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
    <div>
      <div class="section-head" id="answer" style="margin-top:0"><h2>The short answer</h2></div>
      {ownRun && (
        <a class="card own-test" href={`/tests/${task.normie_test}`}>
          <div class="mono-label">Normie Mode test · Draft</div>
          <h3>We tested this ourselves</h3>
          <p class="small">Best overall: <strong>{rankRun(ownRun)[0].name}</strong> ({rankRun(ownRun)[0].why.toLowerCase()}). See every question and answer →</p>
        </a>
      )}
      <BarChart
        title={`Task score: ${name}`}
        sub={`Combines ${scores.testsUsed} test${scores.testsUsed === 1 ? '' : 's'}. The best model scores 100`}
        rows={scores.rows}
        summary={leaderLine}
        showEmpty={false}
      />
      <NormSays text={scoreNorm.text} status={scoreNorm.status} />

      {normOn && (
        <>
          <div class="section-head" id="guide"><h2>Norm's guide</h2></div>
          <p class="section-sub">What I'd tell a friend who asked.{norm!.status === 'draft' && <span class="badge draft" style="margin-left:0.5rem">Draft</span>}</p>
          <div class="guide">
            <section><h3>What AI is good at</h3><ul>{norm!.good_at.map((x) => <li>{x}</li>)}</ul></section>
            <section><h3>Where it trips up</h3><ul>{norm!.trips_up.map((x) => <li>{x}</li>)}</ul></section>
            <section><h3>How to get a good result</h3><ul>{norm!.how_to.map((x) => <li>{x}</li>)}</ul></section>
          </div>
        </>
      )}

      <div class="section-head" id="evidence"><h2>The evidence</h2></div>
      <p class="section-sub">Each test on its own, labelled by how closely it matches this task.</p>
      {hasWhiskers && <NormSays {...normLine('ci_lines')} />}
      <div class="grid-2">
        {evidence.map((e) => (
          <BarChart
            title={e.test.title}
            sub={`${CLOSENESS_LABEL[e.closeness]} · ${e.test.what}`}
            rows={e.rows}
            floor={testFloor(e.test, e.rows)}
            summary={leadSentence(e.rows)}
            source={testSource(e.test)}
            showEmpty={false}
          />
        ))}
      </div>
      {noResults.length > 0 && <p class="small muted" style="margin-top:1rem">Also relevant, but no results for current models yet: {noResults.map((t) => t.title).join(', ')}.</p>}

      <div class="section-head" id="cost"><h2>What it costs</h2></div>
      <NormSays {...normLine('cost')} />
      <BarChart
        title="Cost per 1,000 typical requests"
        sub="List price, about 1,500 words in and 500 out per request"
        rows={costRows}
        lowerIsBetter
        summary={leadSentence(costRows, true, 'is cheapest')}
        source={{ name: 'models.dev', url: 'https://models.dev', note: 'MIT' }}
        showEmpty={false}
      />

      <div class="plain-section">
        <h3 style="margin-bottom:1rem">Other things people use AI for</h3>
        <ul class="other-tasks">
          {others.map(({ task: t }) => <li><a href={taskPath(t)}>{t.label}</a></li>)}
          <li><a href="/best-ai-for">All tasks →</a></li>
        </ul>
      </div>
    </div>
  </div>
</Base>

<style>
  .own-test { margin-bottom: 1.5rem; background: var(--lavender); }
  .own-test:hover { background: var(--viz-soft); }
  .own-test h3 { margin: 0.5rem 0 0.3rem; }
  .guide { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .guide h3 { font-size: 1.1rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--rule); margin-bottom: 0.4rem; }
  .guide ul { list-style: none; margin: 0; padding: 0; }
  .guide li { padding: 0.55rem 0; border-bottom: 1px solid var(--hair); font-size: 0.95rem; }
  .other-tasks { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
</style>
