---
import Base from '../../layouts/Base.astro';
import Confidence from '../../components/Confidence.astro';
import { graph } from '../../lib/graph';
import { modelName, visibleRecommendations } from '../../lib/view';
const tasks = [...graph().tasks.values()].sort((a, b) => (a.depth === b.depth ? a.name.localeCompare(b.name) : a.depth === 'full' ? -1 : 1));
---
<Base title="Spreadsheet work: what can AI do?">
  <div class="eyebrow">Tasks</div>
  <h1>Spreadsheet work</h1>
  <p class="lede">The spreadsheet jobs people actually ask AI to do, what the evidence says, and which model we'd use.</p>
  <div class="grid">
    {tasks.map((t) => {
      const rec = visibleRecommendations(t.id).find((r) => r.scope === 'best-overall');
      return (
        <a class="card" href={`/tasks/${t.id}`}>
          <h3>{t.name}</h3>
          <p class="small muted">{t.question}</p>
          {rec ? <p class="small">{rec.model_version ? modelName(rec.model_version) : 'No pick yet'} <Confidence level={rec.confidence} /></p> : <p class="small muted">{t.depth === 'stub' ? 'Evidence only, not written up yet' : 'Awaiting review'}</p>}
        </a>
      );
    })}
  </div>
</Base>
